# Supported values: mock / qwen. Mock mode requires no API key.
LLM_PROVIDER=mock

# Qwen / Alibaba Cloud Model Studio (optional)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash
# Legacy OpenAI-compatible endpoint remains usable; workspace-specific endpoints can replace this.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
